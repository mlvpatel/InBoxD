# ============================================================
# n8n Core
# ============================================================
N8N_BASIC_AUTH_USER=           # n8n admin username
N8N_BASIC_AUTH_PASSWORD=       # n8n admin password
N8N_HOST=                      # hostname for n8n (e.g., 0.0.0.0)
N8N_PORT=5678                  # n8n port
N8N_PROTOCOL=https             # http or https
N8N_WEBHOOK_URL=               # public webhook URL (e.g., via ngrok)
N8N_ENCRYPTION_KEY=            # encryption key for credentials storage

# ============================================================
# Local Tunneling (ngrok)
# ============================================================
NGROK_AUTH_TOKEN=              # Required: ngrok auth token for local webhooks
NGROK_DOMAIN=                  # Optional: reserved ngrok domain (if any)

# ============================================================
# Microsoft OAuth (Entra ID for Outlook & Excel)
# ============================================================
MICROSOFT_CLIENT_ID=           # Entra ID App Registration -> Application (client) ID
MICROSOFT_CLIENT_SECRET=       # Entra ID App Registration -> Certificates & secrets -> Secret VALUE
MICROSOFT_TENANT_ID=           # Entra ID App Registration -> Directory (tenant) ID

# ============================================================
# LLM Providers (Cloud Variant)
# ============================================================
OPENAI_API_KEY=                # Default: OpenAI API key (Reference model: gpt-4o-mini)
ANTHROPIC_API_KEY=             # Alternative: Anthropic API key (Reference model: claude-3-haiku)
GEMINI_API_KEY=                # Alternative: Google Gemini API key (Reference model: gemini-1.5-flash)

# ============================================================
# Ollama (local variant only)
# ============================================================
OLLAMA_HOST=http://localhost:11434  # Ollama API endpoint

# ============================================================
# Qdrant (local variant only)
# ============================================================
QDRANT_HOST=http://localhost:6333   # Qdrant REST API endpoint

# ============================================================
# Excel Paths
# ============================================================
ONEDRIVE_EXCEL_PATH=           # OneDrive path to workbook (cloud variant)
LOCAL_EXCEL_PATH=              # Local filesystem path to workbook (local variant)

# ============================================================
# Matching Thresholds
# ============================================================
QDRANT_SCORE_THRESHOLD=0.82   # minimum cosine similarity for embedding match
QDRANT_GAP_THRESHOLD=0.05     # minimum gap between top two results

# ============================================================
# Observability
# ============================================================
LOG_LEVEL=info                 # log verbosity: debug, info, warn, error
LOG_FORMAT=json                # log format: json or text

# ============================================================
# Test Helpers
# ============================================================
TEST_EMAIL_ADDRESS=            # email address for integration testing
TEST_MODE=false                # set to true to skip actual email sending
